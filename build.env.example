# Copy to build.env (ignored by git) and fill in.

# Samsung Partner certificate: author.p12, distributor.p12, password (the .p12 password, one line),
# device-profile.xml (lists your TVs' DUIDs). See "Requirements" in README.md.
CERT_DIR=$HOME/.tizen-notifier/cert

# Per-TV token file; {tv} is replaced by the TV name. Created on the first build of that TV.
TOKEN_FILE=$HOME/.tizen-notifier/token-{tv}

# Hosts the TV may fetch pictures/sounds from and send button callbacks to (Home Assistant, cameras, ...).
ALLOW=homeassistant.local,192.168.1.10

# Dashboards (optional): Home Assistant base URL as the TV reaches it, and a per-TV long-lived token of a
# NON-ADMIN user ({tv} is replaced by the TV name). The token is baked into that TV's build.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN_FILE=$HOME/.tizen-notifier/ha-token-{tv}

# Video relay (optional, relay/ in this repo): where it runs, and the token in its .env (RELAY_TOKEN), if set.
# RELAY_URL=http://192.168.1.10:8792
# RELAY_TOKEN_FILE=$HOME/.tizen-notifier/relay-token

# TVs that run Tizen 5 (built with the TIZEN5 define for tizen50); all others are built for Tizen 6+.
TIZEN5_TVS=""

# TVs that use the shared main window for notifications, including on Tizen 6+.
MAIN_WINDOW_TVS=""

# Command that runs docker for the build. Anything that takes `run ...` works, e.g. "ssh buildhost docker".
BUILD_DOCKER=docker

# Install: sdb and the tizen CLI (Tizen Studio command-line tools) on this machine, or a Docker image that has them.
# The machine that runs sdb must be the TV's Developer Mode "Host PC IP".
TIZEN_TOOLS_IMAGE=""
INSTALL_DOCKER=docker
# TIZEN_STUDIO=$HOME/tizen-studio
