<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the dashboard renderer: same sources as the TV app (src/Dash, src/Json.cs), offline sessions, no NUI. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../src/Json.cs" Link="Json.cs" />
    <Compile Include="../src/Dash/*.cs" LinkBase="Dash" />
    <None Include="../src/res/mdi.tsv.gz" Link="mdi.tsv.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>
</Project>
